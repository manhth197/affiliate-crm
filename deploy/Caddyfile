# Caddy: automatic HTTPS (Let's Encrypt) for DOMAIN, then everything goes to
# the web container's nginx, which serves the React build and proxies /api and
# /socket.io to the API (the same routing as the local docker-compose stack).
# DOMAIN and ACME_EMAIL come from deploy/.env.prod via compose.prod.yml.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Caddy replaces any X-Forwarded-For sent by the client with the real client
	# IP; nginx then appends Caddy's address. Hence TRUST_PROXY=2 on the API.
	reverse_proxy web:80

	# CSP and the other security headers come from the web image's nginx;
	# Caddy only adds what depends on HTTPS.
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	log {
		output stdout
		format console
	}
}
