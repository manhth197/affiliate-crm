# Copy to deploy/.env.prod ON THE SERVER and fill in real values.
# Never commit .env.prod (deploy/.gitignore excludes it).

# Public hostname pointing (A record) to the server's Elastic IP.
# A cheap domain, or a free subdomain such as myname.duckdns.org.
DOMAIN=crm.example.com
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=you@example.com

# Postgres. Use a hex password (no URL-special characters):
#   openssl rand -hex 24
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_DB=affiliate_crm

# Signs access tokens. 48+ random characters:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48

# Partners allowed to call the signed webhook (JSON). [] = none.
PARTNER_WEBHOOKS=[]

# S3 bucket for daily pg_dump backups (deploy/backup.sh). The EC2 instance
# role may only PutObject under backups/ in this bucket.
BACKUP_S3_BUCKET=affiliate-crm-backups-replace-me
