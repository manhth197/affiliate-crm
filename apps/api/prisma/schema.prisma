// Affiliate CRM data model. See docs/api-contract.md for the API shapes.
// Conventions:
// - Tables and columns are snake_case in Postgres (@@map / @map), camelCase in TypeScript.
// - IDs are UUID v7 (time-ordered, so B-tree indexes stay compact).
// - Money is VND stored as BIGINT (Int would overflow at ~2.1 billion VND).
// - Timestamps are timestamptz.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  AFFILIATE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProductCategory {
  LOAN
  CREDIT_CARD
  INSURANCE
}

/// PERCENT: commissionValue is in basis points (150 = 1.5%). FIXED: commissionValue is VND.
enum CommissionType {
  PERCENT
  FIXED
}

enum LeadStatus {
  NEW
  CONTACTED
  SUBMITTED
  APPROVED
  DISBURSED
  REJECTED
}

enum LeadActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE
  WEBHOOK
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  DRAFT
  CONFIRMED
  PAID
}

enum NotificationType {
  LEAD_STATUS_CHANGED
  COMMISSION_CREATED
  PAYOUT_PAID
  LEAD_ASSIGNED
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-cased.
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  /// Normalised VN mobile number, e.g. 0912345678.
  phone        String
  role         Role
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  affiliateProfile   AffiliateProfile?
  refreshTokens      RefreshToken[]
  leads              Lead[]            @relation("LeadAffiliate")
  assignedLeads      Lead[]            @relation("LeadAssignedStaff")
  leadActivities     LeadActivity[]    @relation("ActivityActor")
  assignedActivities LeadActivity[]    @relation("ActivityAssignee")
  commissions        Commission[]
  payouts            Payout[]
  notifications      Notification[]
  auditLogs          AuditLog[]

  @@index([role, status])
  @@map("users")
}

model AffiliateProfile {
  userId       String  @id @map("user_id") @db.Uuid
  referralCode String  @unique @map("referral_code")
  bankName     String? @map("bank_name")
  /// Full account number; the API only exposes a masked form.
  bankAccount  String? @map("bank_account")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("affiliate_profiles")
}

/// Opaque refresh tokens. Only a SHA-256 hash is stored. Tokens are rotated on every use;
/// all tokens issued from one login share a familyId so reuse of a revoked token can
/// revoke the whole family.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id") @db.Uuid
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Product {
  id              String          @id @default(uuid(7)) @db.Uuid
  name            String
  partnerName     String          @map("partner_name")
  category        ProductCategory
  commissionType  CommissionType  @map("commission_type")
  commissionValue Int             @map("commission_value")
  active          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  leads Lead[]

  @@index([active, category])
  @@map("products")
}

model Lead {
  id                 String     @id @default(uuid(7)) @db.Uuid
  /// Sequential number; the public code is "LD-" + number padded to 6 digits.
  number             Int        @unique @default(autoincrement())
  affiliateId        String     @map("affiliate_id") @db.Uuid
  productId          String     @map("product_id") @db.Uuid
  customerName       String     @map("customer_name")
  /// Lower-cased, accent-free copy of customerName for search ("Nguyễn" → "nguyen").
  customerNameSearch String     @map("customer_name_search")
  customerPhone      String     @map("customer_phone")
  customerNationalId String?    @map("customer_national_id")
  requestedAmount    BigInt?    @map("requested_amount")
  disbursedAmount    BigInt?    @map("disbursed_amount")
  status             LeadStatus @default(NEW)
  assignedStaffId    String?    @map("assigned_staff_id") @db.Uuid
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  affiliate     User           @relation("LeadAffiliate", fields: [affiliateId], references: [id])
  product       Product        @relation(fields: [productId], references: [id])
  assignedStaff User?          @relation("LeadAssignedStaff", fields: [assignedStaffId], references: [id])
  activities    LeadActivity[]
  commission    Commission?

  @@index([affiliateId, createdAt])
  @@index([status, createdAt])
  @@index([assignedStaffId])
  @@index([productId])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id         String           @id @default(uuid(7)) @db.Uuid
  leadId     String           @map("lead_id") @db.Uuid
  type       LeadActivityType
  fromStatus LeadStatus?      @map("from_status")
  toStatus   LeadStatus?      @map("to_status")
  note       String?
  /// Null when the change came from a partner webhook.
  actorId    String?          @map("actor_id") @db.Uuid
  /// Set on ASSIGNED entries: who the lead was assigned to.
  assigneeId String?          @map("assignee_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor    User? @relation("ActivityActor", fields: [actorId], references: [id])
  assignee User? @relation("ActivityAssignee", fields: [assigneeId], references: [id])

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Commission {
  id           String           @id @default(uuid(7)) @db.Uuid
  /// One commission per lead: makes the commission job idempotent.
  leadId       String           @unique @map("lead_id") @db.Uuid
  affiliateId  String           @map("affiliate_id") @db.Uuid
  amount       BigInt
  status       CommissionStatus @default(PENDING)
  payoutId     String?          @map("payout_id") @db.Uuid
  cancelReason String?          @map("cancel_reason")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  lead      Lead    @relation(fields: [leadId], references: [id])
  affiliate User    @relation(fields: [affiliateId], references: [id])
  payout    Payout? @relation(fields: [payoutId], references: [id])

  @@index([affiliateId, status])
  @@index([status, createdAt])
  @@index([payoutId])
  @@map("commissions")
}

model Payout {
  id              String       @id @default(uuid(7)) @db.Uuid
  affiliateId     String       @map("affiliate_id") @db.Uuid
  /// "YYYY-MM"
  periodMonth     String       @map("period_month")
  totalAmount     BigInt       @map("total_amount")
  commissionCount Int          @map("commission_count")
  status          PayoutStatus @default(DRAFT)
  paidAt          DateTime?    @map("paid_at") @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  affiliate   User         @relation(fields: [affiliateId], references: [id])
  commissions Commission[]

  /// One payout per affiliate per month: makes the payout job idempotent.
  @@unique([affiliateId, periodMonth])
  @@index([periodMonth, status])
  @@map("payouts")
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String
  /// Flat string map, e.g. { "leadId": "...", "status": "APPROVED" }.
  data      Json             @default("{}")
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

/// Append-only log of sensitive changes (lead status, payouts, admin edits).
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  /// Null for system actors (partner webhook, background jobs).
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Received partner webhook events, used for idempotency by (partnerId, eventId).
model WebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  partnerId   String    @map("partner_id")
  eventId     String    @map("event_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(3)

  @@unique([partnerId, eventId])
  @@map("webhook_events")
}
