# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000

# docker-compose (repo root): Postgres on host port 5433, Redis on host port 6380
DATABASE_URL=postgresql://crm:crm@localhost:5433/affiliate_crm?schema=public
REDIS_URL=redis://localhost:6380

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Rate limit for /auth routes: AUTH_THROTTLE_LIMIT requests per AUTH_THROTTLE_TTL_SECONDS per IP
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# true in production (HTTPS): adds Secure to the crm_rt refresh-token cookie
COOKIE_SECURE=false

# Reverse proxies in front of the API (1 behind Caddy); 0 when exposed directly
TRUST_PROXY=0

# Partners allowed to call POST /webhooks/partner-status (JSON array).
# name must equal Product.partnerName of the leads the partner may update.
PARTNER_WEBHOOKS=[{"id":"an-phat","name":"Tài chính An Phát","secret":"dev-secret-an-phat-change-me"}]

# Re-queue disbursed leads that have no commission every N minutes (0 = off)
COMMISSION_RECONCILE_MINUTES=10
