# Copy to .env.local and adjust. Only VITE_* variables are exposed to the browser.

# Base URL of the Affiliate CRM API (no trailing slash).
VITE_API_URL=http://localhost:3000/api/v1

# "true" = answer API calls in the browser with MSW mocks (no backend needed).
# `npm run dev:mock` turns mocks on regardless of this value.
VITE_USE_MOCKS=false
