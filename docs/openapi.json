  "info": {
    "title": "Affiliate CRM API",
    "description": "REST API for the Affiliate CRM. Source of truth: docs/api-contract.md. Money is VND as integers; dates are ISO 8601 UTC.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "description": "Dotted path of the invalid field, e.g. \"customerPhone\"."
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "field",
          "message"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "message": {
            "type": "string",
            "example": "Validation failed"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            }
          }
        },
        "required": [
          "statusCode",
          "error",
          "message"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "VN mobile number. \"+84\", spaces and dots are accepted and normalised to 0XXXXXXXXX.",
            "example": "0912345678",
            "pattern": "^0[35789]\\d{8}$"
          },
          "email": {
            "type": "string",
            "example": "ctv.moi@example.com",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "At least 8 characters.",
            "example": "MatKhau@123",
            "minLength": 8,
            "maxLength": 128
          },
          "fullName": {
            "type": "string",
            "example": "Trần Thị Bình",
            "maxLength": 100
          }
        },
        "required": [
          "phone",
          "email",
          "password",
          "fullName"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "ADMIN",
          "STAFF",
          "AFFILIATE"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "DISABLED"
        ]
      },
      "AffiliateProfile": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "referralCode": {
            "type": "string",
            "example": "CTV7K3Q9Z"
          },
          "bankName": {
            "type": "string",
            "nullable": true
          },
          "bankAccountMasked": {
            "type": "string",
            "nullable": true,
            "example": "******6789"
          }
        },
        "required": [
          "userId",
          "referralCode",
          "bankName",
          "bankAccountMasked"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UserStatus"
              }
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "affiliate": {
            "$ref": "#/components/schemas/AffiliateProfile"
          },
          "email": {
            "type": "string",
            "example": "ctv1@demo.vn"
          },
          "fullName": {
            "type": "string",
            "example": "Nguyễn Văn An"
          },
          "phone": {
            "type": "string",
            "example": "0912345678"
          }
        },
        "required": [
          "id",
          "role",
          "status",
          "createdAt",
          "email",
          "fullName",
          "phone"
        ]
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/Me"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT, valid for 15 minutes. Send as `Authorization: Bearer <accessToken>`."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque token, valid for 7 days, single use: every refresh returns a new one."
          }
        },
        "required": [
          "user",
          "accessToken",
          "refreshToken"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ctv1@demo.vn",
            "maxLength": 254,
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "Demo@12345",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refresh token returned by login, register or the previous refresh.",
            "maxLength": 512
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT, valid for 15 minutes. Send as `Authorization: Bearer <accessToken>`."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque token, valid for 7 days, single use: every refresh returns a new one."
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "type": "string"
          },
          "db": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          },
          "redis": {
            "enum": [
              "up",
              "down"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "redis"
        ]
      }
    }
  }
}
